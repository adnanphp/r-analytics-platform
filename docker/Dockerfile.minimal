# docker/Dockerfile.minimal
# Even smaller - only what's needed

FROM rocker/shiny:4.3.1

# Install required packages
RUN R -e "install.packages(c('tidyverse', 'shinydashboard', 'shinyWidgets', 'plotly', 'DT', 'viridis'), repos='https://cloud.r-project.org')"

# Copy only what's needed
COPY shiny/ /srv/shiny-server/
COPY data/ /srv/shiny-server/data/
COPY models/ /srv/shiny-server/models/

# Set working directory
WORKDIR /srv/shiny-server

# Run Shiny app
CMD ["R", "-e", "shiny::runApp('app.R', host = '0.0.0.0', port = 3838)"]
